class {{ .ClassName }} < Formula
  desc "{{ .Desc }}"
  homepage "{{ .Homepage }}"
  version "{{ .Version }}"
{{- if .License }}
  license "{{ .License }}"
{{- end }}
{{- if .Versioned }}

  # Pinned releases are keg_only so they do not fight the main formula for
  # the bin/shipshape symlink. Use `brew link --overwrite` to switch.
  keg_only :versioned_formula
{{- end }}
{{- if not .Versioned }}

  # Must precede the on_macos/on_linux blocks; `brew audit` enforces the
  # stanza order.
  head do
    url "https://github.com/{{ .Repo }}.git", branch: "{{ .Branch }}"
    depends_on "go" => :build
  end
{{- end }}

  on_macos do
{{- range .MacOS }}
{{- if .IsIntel }}
    on_intel do
{{- else }}
    on_arm do
{{- end }}
      url "{{ .URL }}"
      sha256 "{{ .SHA256 }}"
    end
{{- end }}
  end

  on_linux do
{{- range .Linux }}
{{- if .IsIntel }}
    on_intel do
{{- else }}
    on_arm do
{{- end }}
      url "{{ .URL }}"
      sha256 "{{ .SHA256 }}"
    end
{{- end }}
  end

  def install
{{- if not .Versioned }}
    if build.head?
      # registry_gen.go and the *_gen.go files are gitignored, so a source
      # build has to generate them before compiling.
      system "go", "generate", "./..."
      system "go", "build", *std_go_args(
        ldflags: "-s -w " \
                 "-X github.com/{{ .Repo }}/cmd.version=#{version} " \
                 "-X github.com/{{ .Repo }}/cmd.commit=#{Utils.git_head}",
      ), "."
    else
      bin.install "{{ .Name }}"
    end
{{- else }}
    bin.install "{{ .Name }}"
{{- end }}
  end

  test do
    assert_match "Version:", shell_output("#{bin}/{{ .Name }} version")
    system bin/"{{ .Name }}", "config", "list-checks"
  end
end
